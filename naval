#!/usr/bin/env bash
# NAVAL — comandos de inicialização com Docker Compose.
# Uso: ./naval <comando> [opções]   |   ./naval help
# Documentação completa: docs/docker.md
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

DEV=(docker compose -f compose.yaml)
PROD=(docker compose -f compose.prod.yaml)

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '› %s\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*" >&2; }
fail() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

require_docker() {
    command -v docker >/dev/null 2>&1 || fail "Docker não encontrado. Instale: https://docs.docker.com/get-docker/"
    docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 não encontrado (comando 'docker compose')."
    docker info >/dev/null 2>&1 || fail "O daemon do Docker não está rodando (ou seu usuário não tem acesso a ele)."
}

# Confere se as variáveis obrigatórias têm valor, sem nunca imprimir o valor.
check_env_file() {
    local file="$1"; shift
    local missing=()
    [[ -f "$file" ]] || { warn "$file não existe. Rode ./naval setup."; return 1; }
    for name in "$@"; do
        local value
        value="$(grep -E "^${name}=" "$file" | tail -n1 | cut -d= -f2- || true)"
        value="${value%\"}"; value="${value#\"}"
        [[ -n "${value// /}" ]] || missing+=("$name")
    done
    if ((${#missing[@]})); then
        warn "$file: preencha ${missing[*]}"
        return 1
    fi
}

check_env() {
    local ok=0
    check_env_file apps/backend/.env SUPABASE_URL SUPABASE_PUBLISHABLE_KEY || ok=1
    check_env_file apps/frontend/.env VITE_SUPABASE_URL VITE_SUPABASE_PUBLISHABLE_KEY || ok=1
    ((ok == 0)) || fail "Configuração incompleta. Veja docs/docker.md (seção Configuração)."
}

cmd_setup() {
    require_docker
    for dir in apps/backend apps/frontend; do
        if [[ -f "$dir/.env" ]]; then
            info "$dir/.env já existe (mantido)."
        else
            cp "$dir/.env.example" "$dir/.env"
            info "Criado $dir/.env a partir de $dir/.env.example."
        fi
    done
    if check_env_file apps/backend/.env SUPABASE_URL SUPABASE_PUBLISHABLE_KEY \
        && check_env_file apps/frontend/.env VITE_SUPABASE_URL VITE_SUPABASE_PUBLISHABLE_KEY; then
        bold "Tudo pronto. Rode: ./naval dev"
    else
        bold "Preencha as variáveis acima com os dados do seu projeto Supabase e rode: ./naval dev"
    fi
}

cmd_dev() {
    require_docker; check_env
    local detach=()
    if [[ "${1:-}" == "-d" || "${1:-}" == "--detach" ]]; then detach=(-d); fi
    # -V recria o volume de node_modules do frontend, para refletir mudanças no package.json.
    "${DEV[@]}" up --build -V --remove-orphans "${detach[@]}"
    if ((${#detach[@]})); then
        bold "NAVAL (dev) rodando em segundo plano"
        info "App: http://localhost:${NAVAL_WEB_PORT:-5173}"
        info "API: http://localhost:${NAVAL_API_PORT:-3000}"
        info "Logs: ./naval logs   |   Parar: ./naval stop"
    fi
}

cmd_prod() {
    require_docker; check_env
    "${PROD[@]}" up --build -d --wait --remove-orphans
    bold "NAVAL (produção local) rodando"
    info "App: ${NAVAL_PUBLIC_ORIGIN:-http://localhost:${NAVAL_HTTP_PORT:-8080}}"
    info "Logs: ./naval logs prod   |   Parar: ./naval stop prod"
}

pick_env() {
    case "${1:-dev}" in
        dev) COMPOSE=("${DEV[@]}") ;;
        prod) COMPOSE=("${PROD[@]}") ;;
        *) fail "Ambiente inválido: $1 (use dev ou prod)" ;;
    esac
}

cmd_stop() {
    require_docker
    case "${1:-dev}" in
        all) "${DEV[@]}" down --remove-orphans; "${PROD[@]}" down --remove-orphans ;;
        *) pick_env "${1:-dev}"; "${COMPOSE[@]}" down --remove-orphans ;;
    esac
}

cmd_restart() {
    require_docker
    local env="dev"
    if [[ "${1:-}" == "dev" || "${1:-}" == "prod" ]]; then env="$1"; shift; fi
    pick_env "$env"
    "${COMPOSE[@]}" restart "$@"
}

cmd_logs() {
    require_docker
    local env="dev"
    if [[ "${1:-}" == "dev" || "${1:-}" == "prod" ]]; then env="$1"; shift; fi
    pick_env "$env"
    "${COMPOSE[@]}" logs -f --tail=100 "$@"
}

cmd_status() {
    require_docker
    bold "Desenvolvimento (compose.yaml)"; "${DEV[@]}" ps
    echo
    bold "Produção local (compose.prod.yaml)"; "${PROD[@]}" ps
}

cmd_shell() {
    require_docker
    local service="${1:-api}"
    if "${DEV[@]}" ps --status running --services | grep -qx "$service"; then
        "${DEV[@]}" exec "$service" bash
    else
        "${DEV[@]}" run --rm --no-deps "$service" bash
    fi
}

cmd_test() {
    require_docker
    local target="${1:-all}"
    case "$target" in
        all|backend|frontend|rls) ;;
        *) fail "Alvo inválido: $target (use all, backend, frontend ou rls)" ;;
    esac
    if [[ "$target" == "all" || "$target" == "backend" ]]; then
        bold "Backend: npm test"
        "${DEV[@]}" run --rm --build --no-deps api npm test
    fi
    if [[ "$target" == "all" || "$target" == "frontend" ]]; then
        bold "Frontend: lint, testes e build"
        # Cada "run" cria um container novo, com node_modules recém-copiado da imagem.
        "${DEV[@]}" run --rm --build --no-deps web sh -c "npm run lint && npm run test && npm run build"
    fi
    if [[ "$target" == "rls" ]]; then
        cmd_rls
    fi
}

cmd_rls() {
    require_docker
    bold "Testes de RLS (PostgreSQL descartável, nunca toca no Supabase remoto)"
    "$ROOT/supabase/run_rls_tests.sh"
}

cmd_clean() {
    require_docker
    warn "Isso remove os containers, volumes e imagens locais do NAVAL (não afeta o Supabase)."
    read -r -p "Continuar? [s/N] " answer
    if [[ ! "$answer" =~ ^[sS]$ ]]; then info "Cancelado."; exit 0; fi
    "${DEV[@]}" down -v --rmi local --remove-orphans
    "${PROD[@]}" down -v --rmi local --remove-orphans
    info "Limpo."
}

cmd_help() {
    cat <<'EOF'
NAVAL — comandos com Docker Compose

  ./naval setup                Cria apps/backend/.env e apps/frontend/.env a partir dos exemplos e confere o que falta
  ./naval dev [-d]             Sobe o ambiente de desenvolvimento (app :5173, API :3000) com hot reload
  ./naval prod                 Sobe o build de produção localmente (nginx em :8080)
  ./naval stop [dev|prod|all]  Para e remove os containers (padrão: dev)
  ./naval restart [dev|prod] [serviço]   Reinicia os serviços (api, web)
  ./naval logs [dev|prod] [serviço]      Acompanha os logs
  ./naval status               Mostra os containers dos dois ambientes
  ./naval shell [api|web]      Abre um terminal dentro do container (padrão: api)
  ./naval test [all|backend|frontend|rls]   Roda os testes dentro dos containers
  ./naval rls                  Roda a suíte de RLS em um PostgreSQL descartável
  ./naval clean                Remove containers, volumes e imagens locais do NAVAL
  ./naval help                 Mostra esta ajuda

Portas configuráveis por variável de ambiente:
  NAVAL_WEB_PORT (5173)  NAVAL_API_PORT (3000)  NAVAL_HTTP_PORT (8080)
  NAVAL_PUBLIC_ORIGIN (http://localhost:8080): origem usada pelo navegador em ./naval prod

Documentação: docs/docker.md
EOF
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi
case "$command" in
    setup) cmd_setup "$@" ;;
    dev|up) cmd_dev "$@" ;;
    prod) cmd_prod "$@" ;;
    stop|down) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    logs) cmd_logs "$@" ;;
    status|ps) cmd_status "$@" ;;
    shell) cmd_shell "$@" ;;
    test) cmd_test "$@" ;;
    rls) cmd_rls "$@" ;;
    clean) cmd_clean "$@" ;;
    help|-h|--help) cmd_help ;;
    *) warn "Comando desconhecido: $command"; cmd_help; exit 1 ;;
esac
