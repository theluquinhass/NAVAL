# URL base da API REST usada pelos serviços do frontend.
# Em desenvolvimento, /api passa pelo proxy do Vite para http://localhost:3000.
# Para acessar o backend diretamente, use http://localhost:3000
# (nesse caso, configure CORS_ORIGIN no backend).
VITE_API_URL=/api

# Supabase (Project URL e chave publicável/anon do projeto)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
